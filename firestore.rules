rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if requester is an authenticated admin/organizer
    // Supports any email provider (Gmail, Yahoo, @alathurpadidars.in, etc.) registered in Firebase Auth
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email != null
      );
    }

    // Public event metadata: Anyone can read, only admin can write
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Schedule Sessions: Anyone can read published, only admin can write or see drafts
    match /schedule/{sessionId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Guests: Anyone can read published, only admin can write or see drafts
    match /guests/{guestId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // FAQs: Anyone can read published, only admin can write
    match /faqs/{faqId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Background Audio Tracks: Anyone can read, only admin can write
    match /audio_tracks/{trackId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SUFFA Dars Directory: Anyone can read, only admin can create/update/delete
    match /dars/{darsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SUFFA Dars Portal Accounts:
    // - Read allowed for login verification against registered phone numbers
    // - Only organizer admin can create, update, or delete Dars login credentials
    match /dars_accounts/{accountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Registrations: 
    // - Anyone can create a registration (fullName and phone required)
    // - Read, update, and delete allowed for organizers and authorized Dars coordinators
    match /registrations/{registrationId} {
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if true;
    }

    // Gate Scans Audit Logs:
    // - Read and create allowed for authorized gate scanning operators and admins
    match /gate_scans/{scanId} {
      allow read, write: if true;
    }

    // Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
